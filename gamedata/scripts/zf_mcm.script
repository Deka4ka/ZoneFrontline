local INTENSITY = {
    calm = { counter_chance = 0.4, raid_chance = 0.1, assault_chance = 0.08, art_chance = 0.05,
        assault_cooldown_h = 96, art_cooldown_h = 72 },
    hot = { counter_chance = 0.9, raid_chance = 0.45, assault_chance = 0.4, art_chance = 0.3,
        assault_cooldown_h = 24, art_cooldown_h = 18 },
}
local KEYS = {}
for _, page in ipairs(PAGES) do
    for _, o in ipairs(page[2]) do
        KEYS[o[1]] = { ROOT .. "/" .. page[1] .. "/" .. o[1], o[2] == "check" and 1 or 2 }
    end
end
function path(key)
    local k = KEYS[key]
    if k then return k[1], k[2] end
end
local function file_value(key, check)
    local v = ini_sys:r_string_ex(SECTION, key)
    if check then return v == "true" or v == "1" or v == "on" end
    return tonumber(v) or 0
end
local function option(o)
    local key = o[1]
    if o[2] == "check" then
        return { id = key, type = "check", val = 1, def = file_value(key, true), hint = "zf_" .. key }
    end
    local min, max, step = o[2], o[3], o[4]
    return { id = key, type = "track", val = 2, min = min, max = max, step = step,
        prec = step < 1 and 2 or 0, def = math.max(min, math.min(max, file_value(key))), hint = "zf_" .. key }
end
function on_mcm_load()
    local pages = {}
    for _, page in ipairs(PAGES) do
        local id = page[1]
        local gr = {
            { id = "title", type = "title", text = "ui_mcm_zf_page_" .. id, align = "l", clr = { 255, 196, 176, 128 } },
            { id = "about", type = "desc", text = "ui_mcm_zf_page_" .. id .. "_desc" },
        }
        if id == "war" then
            local normal = {}
            for k in pairs(INTENSITY.calm) do normal[k] = file_value(k) end
            gr[#gr + 1] = { id = "intensity", type = "preset", val = 0, def = "normal", hint = "zf_intensity", no_str = true,
                content = { { "calm", "ui_mcm_zf_intensity_calm" }, { "normal", "ui_mcm_zf_intensity_normal" },
                    { "hot", "ui_mcm_zf_intensity_hot" } },
                presets = { calm = INTENSITY.calm, normal = normal, hot = INTENSITY.hot } }
        end
        gr[#gr + 1] = { id = "line", type = "line" }
        for _, o in ipairs(page[2]) do gr[#gr + 1] = option(o) end
        pages[#pages + 1] = { id = id, sh = true, text = "ui_mcm_zf_page_" .. id, gr = gr }
    end
    return { id = ROOT, gr = pages }
end
function on_game_start()
    if XrrNet and xrr_mcm_authority and xrr_mcm_authority.declare then
        xrr_mcm_authority.declare(ROOT, "host")
        xrr_mcm_authority.declare(ROOT .. "/debug", "local")
    end
end
