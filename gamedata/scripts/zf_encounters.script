local C = zf_core
local function set(list)
    local t = {}
    for _, v in ipairs(list) do t[v] = true end
    return t
end
local SOUTH = set({ "l01_escape", "k00_marsh", "l02_garbage", "l03_agroprom", "l03u_agr_underground",
    "k01_darkscape", "l04_darkvalley", "l04u_labx18", "l05_bar", "l06_rostok", "y04_pole" })
local NORTH = set({ "l10_red_forest", "l10_radar", "l10_limansk", "l10u_bunker", "l11_hospital", "l11_pripyat",
    "pripyat", "l12_stancia", "l12_stancia_2", "l12u_sarcofag", "l12u_control_monolith", "l13_generators",
    "l13u_warlab" })
local TIERS = {
    south = { novice = 5, advanced = 3, veteran = 1 },
    mid   = { novice = 2, advanced = 4, veteran = 3, alpha = 1 },
    north = { advanced = 2, veteran = 4, alpha = 2 },
}
local MUTANTS = {
    south = { "simulation_dog", "simulation_mix_dogs", "simulation_flesh", "simulation_boar",
        "simulation_mix_boar_flesh", "simulation_pseudodog", "simulation_cat", "simulation_tushkano_7_10" },
    mid   = { "simulation_bloodsucker", "simulation_snork_2_5", "simulation_pseudodog", "simulation_psy_dog_squad",
        "simulation_lurker", "simulation_boar_3_5", "simulation_fracture", "simulation_zombie_3_6" },
    north = { "simulation_bloodsucker_black", "simulation_chimera", "simulation_burer", "simulation_controller",
        "simulation_gigant", "simulation_psysucker", "simulation_poltergeist_flame", "simulation_contr_4zomb_norm" },
    night = { "simulation_bloodsucker", "simulation_bloodsucker_black", "simulation_psysucker",
        "simulation_snork_2_5", "simulation_chimera", "simulation_lurker_black", "simulation_poltergeist" },
}
local PREFIX = { dolg = "duty", killer = "merc" }
local FALLBACK = { alpha = "veteran", sniper = "veteran", veteran = "advanced", advanced = "novice" }
function pick(list)
    if #list > 0 then return list[math.random(#list)] end
end
local function weighted(t)
    local total = 0
    for _, w in pairs(t) do total = total + w end
    local r = math.random() * total
    for k, w in pairs(t) do
        r = r - w
        if r <= 0 then return k end
    end
end
function squad_section(f, tier)
    while tier do
        local sec = (tier == "alpha") and (f .. "_sim_squad_alpha") or ((PREFIX[f] or f) .. "_sim_squad_" .. tier)
        if ini_sys:section_exist(sec) then return sec end
        tier = FALLBACK[tier]
    end
end
function tier(ctx, elite)
    if elite then return math.random() < 0.5 and "veteran" or "alpha" end
    local t = weighted(TIERS[ctx.region])
    if ctx.night and t == "novice" and math.random() < 0.5 then t = "advanced" end
    return t
end
function mutant(ctx, nocturnal)
    local pool = {}
    for _, sec in ipairs(MUTANTS[nocturnal and "night" or ctx.region]) do
        if ini_sys:section_exist(sec) then pool[#pool + 1] = sec end
    end
    return pick(pool)
end
function factions(ok)
    local out = {}
    for _, f in ipairs(C.war_factions()) do
        if ok(f) then out[#out + 1] = f end
    end
    return out
end
local function hostile(ctx) return factions(function(f) return C.enemies(f, ctx.af) end) end
local function friendly(ctx) return factions(function(f) return C.friends(f, ctx.af) end) end
local function not_hostile(ctx) return factions(function(f) return not C.enemies(f, ctx.af) end) end
function far(ctx, except)
    local list = {}
    for _, sm in ipairs(ctx.far) do
        if not (except and sm.id == except.id) then list[#list + 1] = sm end
    end
    return pick(list)
end
function quiet(list, sides, except)
    local best, bs
    for _, sm in ipairs(list or {}) do
        if not (except and sm.id == except.id) then
            local s = math.random()
            for id in pairs((SIMBOARD.smarts[sm.id] or {}).squads or {}) do
                local sq = C.live_squad(id)
                local f = sq and sq:get_squad_community()
                if f and not sides[f] then s = s + 1 end
            end
            local o = sm.owning_faction
            for f in pairs(sides) do
                if C.human(o) and C.enemies(f, o) then s = s + 3 end
            end
            if not bs or s < bs then best, bs = sm, s end
        end
    end
    return best
end
function wide(ctx, dmin, dmax)
    local out, p = {}, ctx.target.position
    for _, sm in ipairs(C.smarts_on_level(ctx.lid)) do
        local d = sm.position:distance_to(p)
        if d >= dmin and d <= dmax then out[#out + 1] = sm end
    end
    return out
end
function across(ctx, from)
    local best, bd
    for _, sm in ipairs(ctx.far) do
        local d = sm.position:distance_to(from.position)
        if sm.id ~= from.id and (not bd or d > bd) then best, bd = sm, d end
    end
    return best
end
function squad(out, sec, from, to)
    if not (sec and from and to) then return end
    local ok, sq = pcall(warfare.spawn_squad, sec, from)
    if not (ok and sq) then
        C.warn("encounter spawn failed: %s at %s: %s", sec, from:name(), sq)
        return
    end
    C.send(sq, to.id, C.cfg("enc_lifetime_h", 6))
    C.shield(sq, C.cfg("enc_lifetime_h", 6))
    out[#out + 1] = sq
    return sq
end
local function foes(a, b)
    if a and b then C.feud(a.id, b.id, C.cfg("enc_lifetime_h", 6)) end
end
local function news(key, f, snd, ...)
    return { key = key, f = f, snd = snd, args = { ... } }
end
local TEMPLATES = {
    {   id = "ambush", w = 10,
        run = function(ctx)
            local f, out = pick(hostile(ctx)), {}
            if not f then return end
            for _ = 1, ctx.night and 2 or 1 do
