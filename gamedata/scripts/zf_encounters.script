    {   id = "road_ambush", w = 4,
        run = function(ctx)
            local f = pick(hostile(ctx))
            if not f then return end
            local out, at = {}, far(ctx)
            squad(out, squad_section(f, tier(ctx)), at, at)
            return out
        end },
}
function battlefield(ctx)
    local list, t = {}, C.now()
    for id, when in pairs(C.store("battles")) do
        local sm = alife_object(id)
        if sm and t - when < 6 * C.HOUR and C.smart_level(sm) == ctx.lid then list[#list + 1] = sm end
    end
    return pick(list)
end
function trim(sq, keep)
    local extra = {}
    for m in sq:squad_members() do
        if m.id ~= sq:commander_id() then extra[#extra + 1] = m.id end
    end
    for i = keep, #extra do sq:remove_npc(extra[i], true) end
end
function track(tag, squads, hours)
    local rec = {}
    for _, sq in ipairs(squads) do rec[#rec + 1] = { id = sq.id, sec = sq:section_name() } end
    C.store("enc")[tag .. "_" .. C.now() .. "_" .. math.random(999)] = { tag = tag,
        squads = rec, expire = C.now() + (hours or C.cfg("enc_lifetime_h", 6)) * C.HOUR }
end
local CALM = set({ "distress", "convoy", "lost_patrol", "checkpoint", "last_stand", "vip_escort", "lost_rookie",
    "artefact_hunters", "caravan", "hunters", "courier", "defector", "delegation", "deserters", "prisoners",
    "scientists", "wounded" })
local UNMARKED = set({ "trader_gone" })
local shown = {}
local function spot_of(tag)
    return CALM[tag] and "green_location" or "red_location"
end
local function hint(m)
    local s = game.translate_string("zf_mark_" .. m.tag)
    return m.f and m.f ~= "" and (s .. " (" .. C.faction_name(m.f) .. ")") or s
end
local function unshow(id)
    local spot = shown[id]
    if spot and level.map_has_object_spot(id, spot) ~= 0 then level.map_remove_object_spot(id, spot) end
    shown[id] = nil
end
function marks()
    local out = {}
    if not C.cfg("event_marks", true) then return out end
    for key, e in pairs(C.store("enc")) do
        local tag = e.tag or key:match("^(.-)_[%d%.]+_%d+$")
        if tag and not UNMARKED[tag] then
            for _, s in ipairs(e.squads) do
                local sq = alife_object(s.id)
                if sq and sq:clsid() == clsid.online_offline_group_s and sq:section_name() == s.sec and sq:npc_count() > 0 then
                    out[#out + 1] = { id = s.id, sid = sq.current_target_id or sq.assigned_target_id or 0, tag = tag,
                        f = sq:get_squad_community() }
                end
            end
        end
    end
    local ok, waiting = pcall(zf_events.waiting)
    for _, m in ipairs(ok and waiting or {}) do out[#out + 1] = m end
    return out
end
function show(list, by_point)
    local want = {}
    for _, m in ipairs(list or {}) do
        local id = by_point and m.sid or m.id
        if id and id > 0 and not want[id] and alife_object(id) then
            local spot = spot_of(m.tag)
            want[id] = true
            if shown[id] and shown[id] ~= spot then unshow(id) end
            if not shown[id] and level.map_has_object_spot(id, spot) == 0 then
                level.map_add_object_spot(id, spot, hint(m))
                shown[id] = spot
            end
        end
    end
    for id in pairs(shown) do
        if not want[id] then unshow(id) end
    end
end
function region(lid)
    local lname = alife():level_name(lid)
    return SOUTH[lname] and "south" or NORTH[lname] and "north" or "mid"
end
function context()
    local af = warfare.actor_faction
    local ps = C.players()
    if not af or #ps == 0 then return end
    local anchor = ps[math.random(#ps)]
    local lid, apos = C.player_level(anchor), anchor:position()
    local dmin, dmax = C.cfg("enc_min_dist", 120), C.cfg("enc_max_dist", 350)
    local far_list, target, td = {}, nil, nil
    for _, sm in ipairs(C.smarts_on_level(lid)) do
        local d = sm.position:distance_to(apos)
        if d >= dmin and d <= dmax then far_list[#far_list + 1] = sm end
        if not td or d < td then target, td = sm, d end
    end
    if not target or #far_list < 2 then return end
    return {
        af = af, lid = lid, target = target, far = far_list,
        region = region(lid),
        night = warfare_utils.is_night(),
    }
end
local function near_player(sq, ps)
    local lid = C.level_of(sq)
    for _, p in ipairs(ps) do
        if C.player_level(p) == lid and sq.position:distance_to(p:position()) < 200 then return true end
    end
    return false
end
local function housekeeping()
    local enc, t, ps, live = C.store("enc"), C.now(), C.players(), 0
    for key, e in pairs(enc) do
        local alive = 0
        for _, s in ipairs(e.squads) do
            local sq = alife_object(s.id)
            if sq and sq:clsid() == clsid.online_offline_group_s and sq:section_name() == s.sec then
                if t >= e.expire and not near_player(sq, ps) then
                    unshow(s.id)
                    alife_release(sq)
                else
                    alive = alive + 1
                end
            end
        end
        if alive == 0 then enc[key] = nil else live = live + 1 end
    end
    return live
end
local function eligible(ctx, t)
    return (not t.night or ctx.night) and (not t.region or t.region == ctx.region)
end
local function run()
    if housekeeping() >= C.cfg("enc_max_active", 2) or not C.ready("enc") or not C.cfg("enc_enabled", true) then return end
    if C.crowded() then return end
    if math.random() > C.cfg("enc_chance", 0.5) then
        C.cooldown("enc", 0.25)
        return
    end
    local ctx = context()
    if not ctx then return end
    local pool = {}
    for i, t in ipairs(TEMPLATES) do
        if eligible(ctx, t) then pool[i] = t.w end
    end
    for _ = 1, 6 do
        local t = TEMPLATES[weighted(pool)]
        local squads, msg = t.run(ctx)
        if squads and #squads > 0 then
            track(t.id, squads)
            C.cooldown("enc", C.cfg("enc_cooldown_h", 2) * C.rand(0.6, 1.4))
            C.log("encounter %s at %s (%s, %s): %d squads", t.id, ctx.target:name(), ctx.region,
                ctx.night and "night" or "day", #squads)
            if msg then C.report("event", msg.f, true, msg.key, msg.f, msg.snd, unpack(msg.args)) end
            return
        end
    end
end
local function on_npc_death(squad)
    local at = squad and squad.online and squad.current_target_id
    if at and alife_object(at) then C.store("battles")[at] = C.now() end
end
local function forget_battles()
    local b, t = C.store("battles"), C.now()
    for id, when in pairs(b) do
        if t - when > 6 * C.HOUR then b[id] = nil end
    end
end
function on_game_start()
    C.every("zf_encounters", 60, run)
    C.every("zf_marks", 5, function() show(marks()) end, true)
    zf_front.on_update(function(s) if C.peer() then show(s.marks, true) end end)
    C.every("zf_battles", 300, forget_battles, true)
    RegisterScriptCallback("squad_on_npc_death", C.guard("zf_encounters.npc_death", on_npc_death))
end
